{
  "version": 2,
  "routes": [
    { "src": "/api/checkout", "dest": "/api/checkout.js" },
    { "src": "/api/session",  "dest": "/api/session.js"  },
    { "src": "/api/webhook",  "dest": "/api/webhook.js"  },
    { "src": "/api/generate", "dest": "/api/generate.js" },
    { "src": "/quiz",         "dest": "/quiz.html"       },
    { "src": "/roteiro",      "dest": "/roteiro.html"    },
    { "src": "/",             "dest": "/index.html"      }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}